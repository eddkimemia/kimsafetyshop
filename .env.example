# ------------------------------------------------------------------
# KimSafety — environment variables
# Copy this file to .env (local) and/or set the same keys in your
# hosting provider (e.g. Vercel Project Settings → Environment Variables).
# SMTP is configured ONLY here — never through the admin settings page.
# ------------------------------------------------------------------

# ---- Database (Postgres) ----
DATABASE_URL=postgresql://user:password@host:5432/kimsafety?sslmode=require
# Optional: a separate connection string for Prisma migrations (e.g. Neon pooler)
# DIRECT_URL=postgresql://user:password@host:5432/kimsafety?sslmode=require

# ---- NextAuth (sessions + password-reset token signing) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-long-random-secret
# NEXTAUTH_URL=https://your-domain.com

# ---- SMTP — sends invoices, order confirmations, password resets & newsletters ----
# Required for any transactional email. Gmail example below; use an app password.
# Port 465 implies SSL; 587 implies STARTTLS. Set SMTP_SECURE=true to force SSL on any port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kimsafetyltd@gmail.com
SMTP_PASS=dwop iaog uiwk thjc
# Optional "From" — defaults to the SMTP user if unset
SMTP_FROM=KimSafety Ltd <kimsafetyltd@gmail.com>
# SMTP_SECURE=false

# ---- Admin seed account (created on first deploy / seed) ----
ADMIN_EMAIL=admin@kimsafety.co.ke
ADMIN_PASSWORD=change-this-password

# ---- Site URL (canonical domain used in emails, OG images, sitemap) ----
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- M-Pesa (Daraja) — Lipa Na M-Pesa Online (STK push) ----
# Defaults below are Safaricom's public SANDBOX test credentials (test number 254708374149).
# For live payments: MPESA_ENV=production and your own app keys from the Safaricom
# developer portal (https://developer.safaricom.co.ke). The STK callback hits
# /api/payments/mpesa/callback on this site automatically.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=9v38Daj5QuvApXBx8rgFh9dXk1pM7k9X
MPESA_CONSUMER_SECRET=POjCz4tZQ5b0w2aJ
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd9a467552e2d03e4b0f9b3e8f5f0a0b3a9c6f0c0b0
MPESA_SHORTCODE=174379
# MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback

# ---- Paystack (cards) ----
# Get keys from https://dashboard.paystack.com (Test mode for testing).
# sk_test_... = secret key (server only, never exposed to the client).
# Register the webhook URL in the Paystack dashboard (Settings → Webhooks):
# https://your-domain.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional ----
# Google Analytics 4 measurement id
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Path to a Python binary for server-side image processing (defaults to "python")
# PYTHON=python
